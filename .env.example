# LiveGuard — Environment Variables
#
# These MUST be configured in the Vercel project settings (not in .env files
# for production). See: https://vercel.com/[org]/liveguard/settings/environment-variables

# ─── Required (server-side only, never exposed to client) ───────────

# API key for the Hybrid Vector API (upstream verify endpoint).
# Without this, the proxy returns 500 "Server misconfigured".
# Get this from the demoguard Vercel project (same key) or from
# the hybrid-vector-api Render service env vars.
HV_API_KEY=

# ─── Optional (has defaults) ────────────────────────────────────────

# Upstream Hybrid Vector API URL.
# STEP 4 MIGRATION: now routes through the Cloudflare Worker (api.hcs-u7.org/hv)
# instead of calling Render directly. The Worker applies WAF, rate limiting,
# bot detection, and injects X-HCS-Worker-Auth + X-Behavioral-Risk-Score.
# Default: https://api.hcs-u7.org/hv
# HYBRID_VECTOR_API_URL=https://api.hcs-u7.org/hv

# Tenant ID for LiveGuard sessions (default: liveguard-demo)
# LIVEGUARD_TENANT_ID=liveguard-demo

# Additional CORS origins (comma-separated, added to the default list)
# Both LIVEGUARD_ALLOWED_ORIGINS (canonical) and PAYGUARD_ALLOWED_ORIGINS
# (legacy name) are supported. When adding a new custom domain to this
# Vercel deployment, either add it here or add it to DEFAULT_ALLOWED_ORIGINS
# in api/liveguard/verify.ts and api/liveguard/session-behavior-ping.ts.
# LIVEGUARD_ALLOWED_ORIGINS=https://my-custom-domain.com

# Rate limit per minute (0 = disabled, default: 0)
# LIVEGUARD_PROXY_RATE_LIMIT_PER_MIN=0

# ─── Client-side (exposed to browser, must be set in Vercel) ────────

# Production URL for QR codes / dashboard links (no default —
# liveguard.vercel.app belongs to an unrelated project)
# VITE_LIVEGUARD_URL=https://liveguard-topaz.vercel.app

# Session endpoint override (default: https://api.hcs-u7.org/api/cognitive/liveguard/session)
# VITE_LIVEGUARD_SESSION_ENDPOINT=https://api.hcs-u7.org/api/cognitive/liveguard/session

# Enable LiveGuard (default: false)
# VITE_LIVEGUARD_ENABLED=true
